{
  "name": "whispering-wilds",
  "version": "1.0.0",
  "description": "The Whispering Wilds (Kaattu Vazhi / Thadam) - An Open-World Narrative Exploration Game across Tamil Nadu",
  "main": "index.html",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "serve": "npx -y serve .",
    "desktop": "electron desktop/electron/main.js",
    "desktop:dev": "electron desktop/electron/main.js --dev",
    "desktop:build": "node desktop/scripts/verify-build.js",
    "desktop:build:windows": "node desktop/scripts/build-windows.js",
    "desktop:build:macos": "node desktop/scripts/build-macos.js",
    "desktop:build:linux": "node desktop/scripts/build-linux.js",
    "desktop:test": "powershell -ExecutionPolicy Bypass -File run_tests.ps1",
    "desktop:verify": "node desktop/scripts/verify-build.js && node desktop/scripts/check-assets.js && node desktop/scripts/check-platform.js",
    "app": "powershell -ExecutionPolicy Bypass -File Launch-Game-PC.ps1",
    "validate": "node scripts/validate-data.js && node scripts/validate-links.js && node scripts/validate-production.js",
    "build-report": "node scripts/build-report.js",
    "production-check": "node scripts/validate-production.js",
    "compatibility:test": "powershell -ExecutionPolicy Bypass -File run_tests.ps1",
    "compatibility:verify": "node scripts/verify-compatibility.js",
    "compatibility:report": "node scripts/verify-compatibility.js",
    "release:verify": "node scripts/release-verify.js",
    "assets:validate": "node scripts/validate-assets.js",
    "assets:report": "node tools/asset-audit/generate-asset-report.js",
    "animations:validate": "node tools/animation-validation/validate-animations.js",
    "textures:validate": "node tools/texture-validation/validate-textures.js",
    "production:assets": "node tools/asset-audit/generate-asset-report.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "keywords": [
    "game",
    "tamil-nadu",
    "open-world",
    "canvas",
    "web-audio",
    "adventure",
    "survival"
  ],
  "author": "Mohan",
  "license": "MIT"
}
