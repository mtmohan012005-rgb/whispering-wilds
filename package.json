{
  "name": "whispering-wilds",
  "version": "1.0.0",
  "description": "The Whispering Wilds (Kaattu Vazhi / Thadam) - A Unity 6 Open-World Narrative Exploration Game across Tamil Nadu",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "app": "powershell -ExecutionPolicy Bypass -File Launch-Game-PC.ps1",
    "verify-game": "node scripts/verify-game.js",
    "verify-assets": "node scripts/verify-assets.js",
    "verify-production": "node scripts/verify-production.js",
    "verify-audit-evidence": "node scripts/verify-audit-evidence.js",
    "validate": "node scripts/verify-game.js && node scripts/verify-production.js",
    "test": "node scripts/run-all-tests.js",
    "test:candidate-launcher": "node scripts/verify-candidate-launcher.js",
    "test:map-data": "node scripts/verify-map-data.js",
    "test:backend": "node scripts/test-backend-security.js",
    "test:cloudsave": "node scripts/test-cloud-save-regression.js",
    "assets:validate": "node scripts/validate-assets.js",
    "assets:report": "node tools/asset-audit/generate-asset-report.js",
    "animations:validate": "node tools/animation-validation/validate-animations.js",
    "textures:validate": "node tools/texture-validation/validate-textures.js",
    "production:assets": "node tools/asset-audit/generate-asset-report.js",
    "build-report": "node scripts/build-report.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5"
  },
  "keywords": [
    "game",
    "tamil-nadu",
    "open-world",
    "unity",
    "hdrp",
    "adventure",
    "investigation"
  ],
  "author": "Mohan",
  "license": "MIT",
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
