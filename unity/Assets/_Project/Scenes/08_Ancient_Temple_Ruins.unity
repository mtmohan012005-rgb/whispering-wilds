  clue2English: The second stone shows the flowing river Kaveri.
  clue3English: The third stone carries the palm tree of Chola.
  clue1Tamil: "\u0BAE\u0BC1\u0BA4\u0BB2\u0BCD \u0B95\u0BB2\u0BCD\u0BB2\u0BBF\u0BB2\u0BCD \u0B9A\u0BC2\u0BB0\u0BBF\u0BAF \u0B89\u0BA4\u0BAF\u0BA4\u0BCD\u0BA4\u0BBF\u0BA9\u0BCD \u0B95\u0BC1\u0BB1\u0BBF\u0BAF\u0BC0\u0B9F\u0BC1 \u0B89\u0BB3\u0BCD\u0BB3\u0BA4\u0BC1."
  clue2Tamil: "\u0B87\u0BB0\u0BA3\u0BCD\u0B9F\u0BBE\u0BB5\u0BA4\u0BC1 \u0B95\u0BB2\u0BCD\u0BB2\u0BBF\u0BB2\u0BCD \u0B95\u0BBE\u0BB5\u0BBF\u0BB0\u0BBF \u0BA8\u0BA4\u0BBF \u0B93\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1."
  clue3Tamil: "\u0BAE\u0BC2\u0BA9\u0BCD\u0BB1\u0BBE\u0BB5\u0BA4\u0BC1 \u0B95\u0BB2\u0BCD\u0BB2\u0BBF\u0BB2\u0BCD \u0B9A\u0BCB\u0BB4\u0BB0\u0BBF\u0BA9\u0BCD \u0BA4\u0BC7\u0BA9\u0BCD\u0BAE\u0BB0\u0BAE\u0BCD \u0B89\u0BB3\u0BCD\u0BB3\u0BA4\u0BC1."
  hintEnglish: "Remember: Sun, River, Palm \u2014 the order of nature."
  hintTamil: "\u0BA8\u0BBF\u0BA9\u0BC8\u0BB5\u0BBF\u0BB2\u0BCD \u0B95\u0BCA\u0BB3\u0BCD\u0BB3\u0BC1\u0B99\u0BCD\u0B95\u0BB3\u0BCD: \u0B9A\u0BC2\u0BB0\u0BBF\u0BAF\u0BA9\u0BCD, \u0BA8\u0BA4\u0BBF, \u0BA4\u0BC7\u0BA9\u0BCD\u0BAE\u0BB0\u0BAE\u0BCD \u2014 \u0B87\u0BAF\u0BB1\u0BCD\u0B95\u0BC8\u0BAF\u0BBF\u0BA9\u0BCD \u0BB5\u0BB0\u0BBF\u0B9A\u0BC8."
