      objectReference: {fileID: 0}
    - target: {fileID: 1079155329661015661, guid: 05eb25ed3c32be24ba4d5f6be2df36ed, type: 3}
      propertyPath: displayNameTa
      value: "\u0B86\u0BB1\u0BC1\u0BAE\u0BC1\u0B95\u0BAE\u0BCD (\u0BB5\u0BBF\u0BB5\u0B9A\u0BBE\u0BAF\u0BBF)"
      objectReference: {fileID: 0}
    - target: {fileID: 1079155329661015661, guid: 05eb25ed3c32be24ba4d5f6be2df36ed, type: 3}
      propertyPath: profileDescription
      value: "\u0B95\u0BBE\u0BB5\u0BBF\u0BB0\u0BBF \u0B9F\u0BC6\u0BB2\u0BCD\u0B9F\u0BBE \u0BAA\u0BBE\u0BB0\u0BAE\u0BCD\u0BAA\u0BB0\u0BBF\u0BAF \u0BA8\u0BC6\u0BB2\u0BCD \u0BB5\u0BBF\u0BB5\u0B9A\u0BBE\u0BAF\u0BBF \u0B86\u0BB1\u0BC1\u0BAE\u0BC1\u0B95\u0BAE\u0BCD."
      objectReference: {fileID: 0}
    - target: {fileID: 1079155329661015661, guid: 05eb25ed3c32be24ba4d5f6be2df36ed, type: 3}
      propertyPath: dialogueNodes.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1079155329661015661, guid: 05eb25ed3c32be24ba4d5f6be2df36ed, type: 3}
      propertyPath: dialogueNodes.Array.data[0].speakerTextEn
      value: The rice grows tall when the river is kind. This year the water came late.
      objectReference: {fileID: 0}
    - target: {fileID: 1079155329661015661, guid: 05eb25ed3c32be24ba4d5f6be2df36ed, type: 3}
      propertyPath: dialogueNodes.Array.data[0].speakerTextTa
      value: "\u0B95\u0BBE\u0BB5\u0BBF\u0BB0\u0BBF \u0BA8\u0BC0\u0BB0\u0BCD \u0BA4\u0BBE\u0BAE\u0BA4\u0BAE\u0BBE \u0BB5\u0BA8\u0BCD\u0BA4\u0BBF\u0BA4\u0BC1. \u0BA8\u0BC6\u0BB2\u0BC1\u0B95\u0BCD\u0B95\u0BC1 \u0BA8\u0BC7\u0BB0\u0BAE\u0BBF\u0BB2\u0BCD\u0BB2\u0BBE\u0BAE\u0BC1\u0B9F\u0BC8\u0BAF\u0BBE\u0B9A\u0BCD\u0B9A\u0BC1."
      objectReference: {fileID: 0}
    - target: {fileID: 1079155329661015661, guid: 05eb25ed3c32be24ba4d5f6be2df36ed, type: 3}
      propertyPath: dialogueNodes.Array.data[0].choices.Array.size
