      propertyPath: dialogueNodes.Array.data[0].choices.Array.data[0].choiceTextEn
      value: Thank you.
      objectReference: {fileID: 0}
    - target: {fileID: 1079155329661015661, guid: 05eb25ed3c32be24ba4d5f6be2df36ed, type: 3}
