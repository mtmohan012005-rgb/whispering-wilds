    locationName: Shared Bench
    isMandatory: 0
  - startHour24: 20
    durationHours: 3
    state: 8
    activityDescriptionEn: Resting on the verandah
    activityDescriptionTa: "\u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0B9F\u0BC8 \u0BAE\u0BBE\u0B9F\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD \u0B93\u0BAF\u0BCD\u0BB5\u0BC1"
