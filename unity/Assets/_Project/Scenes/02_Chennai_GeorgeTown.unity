    activityDescriptionEn: Eating at home
    activityDescriptionTa: "\u0BB5\u0BC0\u0B9F\u0BCD\u0B9F\u0BBF\u0BB2\u0BCD \u0B9A\u0BBE\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BC1\u0BA4\u0BB2\u0BCD"
