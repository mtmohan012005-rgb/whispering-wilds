  - startHour24: 14
    durationHours: 3.5
    state: 2
    activityDescriptionEn: Handicraft work at the frontage
    activityDescriptionTa: "\u0B95\u0BC8\u0BA4\u0BCD\u0BA4\u0BCA\u0BB4\u0BBF\u0BB2\u0BCD \u0BAA\u0BA3\u0BBF"
    targetPosition: {x: 7.4, y: 0.15, z: -6}
    targetAnchor: {fileID: 1115529477}
    locationName: Workplace
    isMandatory: 1
  - startHour24: 18
    durationHours: 2
    state: 7
    activityDescriptionEn: Evening conversation
    activityDescriptionTa: "\u0BAE\u0BBE\u0BB2\u0BC8 \u0BAA\u0BC7\u0B9A\u0BCD\u0B9A\u0BC1"
    targetPosition: {x: 6.7, y: 0.15, z: 6}
    targetAnchor: {fileID: 1583043729}
    locationName: Shared Bench
    isMandatory: 0
  - startHour24: 20
    durationHours: 1
    state: 6
    activityDescriptionEn: Eating at home
    activityDescriptionTa: "\u0BB5\u0BC0\u0B9F\u0BCD\u0B9F\u0BBF\u0BB2\u0BCD \u0B9A\u0BBE\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BC1\u0BA4\u0BB2\u0BCD"
    targetPosition: {x: 6.43, y: 0.15, z: -1}
    targetAnchor: {fileID: 378344228}
    locationName: Shared Bench
    isMandatory: 0
  - startHour24: 20
    durationHours: 3
    state: 8
    activityDescriptionEn: Resting on the verandah
    activityDescriptionTa: "\u0BAE\u0BC7\u0BB1\u0BCD\u0BAA\u0B9F\u0BC8 \u0BAE\u0BBE\u0B9F\u0BA4\u0BCD\u0BA4\u0BBF\u0BB2\u0BCD \u0B93\u0BAF\u0BCD\u0BB5\u0BC1"
    targetPosition: {x: 6.43, y: 0.15, z: -1}
    targetAnchor: {fileID: 378344228}
    locationName: Home
    isMandatory: 0
  - startHour24: 0
    durationHours: 6
    state: 11
    activityDescriptionEn: Asleep
    activityDescriptionTa: "\u0B89\u0BB1\u0B95\u0BCD\u0B95\u0BAE\u0BCD"
    targetPosition: {x: 6.43, y: 0.15, z: -1}
    targetAnchor: {fileID: 378344228}
    locationName: Home
    isMandatory: 0
  legacySchedule: []
  dialogueNodes:
  - nodeIndex: 0
    speakerTextEn: I am Meenakshi. I follow paper trails. Court records usually know where the mangroves went.
    speakerTextTa: "\u0BA8\u0BBE\u0BA9\u0BCD \u0BAE\u0BC0\u0BA9\u0BBE\u0B9F\u0BCD\u0B9A\u0BBF. \u0B86\u0BB5\u0BA3\u0BAA\u0BCD \u0BAA\u0BBE\u0BA4\u0BC8\u0B95\u0BB3\u0BC8\u0BA4\u0BCD \u0BA4\u0BCA\u0B9F\u0BB0\u0BCD\u0B95\u0BBF\u0BB1\u0BC7\u0BA9\u0BCD. \u0BA8\u0BC0\u0BA4\u0BBF\u0BAE\u0BA9\u0BCD\u0BB1\u0BAA\u0BCD \u0BAA\u0BA4\u0BBF\u0BB5\u0BC7\u0B9F\u0BCD\u0B9F\u0BBF\u0BB2\u0BCD \u0BAE\u0BA3\u0BCD\u0B9F\u0BB2\u0B99\u0BCD\u0B95\u0BB3\u0BCD \u0B8E\u0B99\u0BCD\u0B95\u0BC7 \u0B9A\u0BC6\u0BA9\u0BCD\u0BB1\u0BA9 \u0B8E\u0BA9\u0BCD\u0BAA\u0BA4\u0BC1 \u0BA4\u0BC6\u0BB0\u0BBF\u0BAF\u0BC1\u0BAE\u0BCD."
    requiredClueId: 
    choices:
    - choiceTextEn: See you around.
      choiceTextTa: "\u0BAA\u0BBF\u0BB1\u0B95\u0BC1 \u0B9A\u0BA8\u0BCD\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BB2\u0BBE\u0BAE\u0BCD."
      nextNodeIndex: -1
      requiredClueId: 
      revealClueId: 
