    speakerTextTa: "\u0BA4\u0BC1\u0BB1\u0BC8 \u0BA8\u0BC0\u0BB0\u0BBF\u0BA9\u0BCD \u0B9A\u0BC1\u0BB5\u0BC8 \u0B92\u0BB5\u0BCD\u0BB5\u0BCA\u0BB0\u0BC1 \u0BAE\u0BBE\u0BA4\u0BAE\u0BC1\u0BAE\u0BCD \u0BB5\u0BC7\u0BB1\u0BC1\u0BAA\u0B9F\u0BC1\u0B95\u0BBF\u0BB1\u0BA4\u0BC1. \u0BAF\u0BBE\u0BB0\u0BC1\u0BAE\u0BCD \u0B8F\u0BA9\u0BCD \u0B8E\u0BA9\u0BCD\u0BB1\u0BC1 \u0B9A\u0BCA\u0BB2\u0BCD\u0BB5\u0BA4\u0BBF\u0BB2\u0BCD\u0BB2\u0BC8."
    requiredClueId: 
    choices:
    - choiceTextEn: See you around.
      choiceTextTa: "\u0BAA\u0BBF\u0BB1\u0B95\u0BC1 \u0B9A\u0BA8\u0BCD\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BB2\u0BBE\u0BAE\u0BCD."
