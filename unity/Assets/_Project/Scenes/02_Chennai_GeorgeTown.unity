    targetPosition: {x: 5.73, y: 0.15, z: 9.7}
    targetAnchor: {fileID: 896337938}
    locationName: Home
    isMandatory: 0
  - startHour24: 0
    durationHours: 6
    state: 11
    activityDescriptionEn: Asleep
    activityDescriptionTa: "\u0B89\u0BB1\u0B95\u0BCD\u0B95\u0BAE\u0BCD"
    targetPosition: {x: 5.73, y: 0.15, z: 9.7}
    targetAnchor: {fileID: 896337938}
    locationName: Home
    isMandatory: 0
  legacySchedule: []
  dialogueNodes:
  - nodeIndex: 0
    speakerTextEn: Kanna kettu, saapta? Sit, sit. The tea is strong today.
    speakerTextTa: "\u0B95\u0BA3\u0BCD\u0BA3\u0BBE \u0B95\u0B9F\u0BCD\u0B9F\u0BC1, \u0B9A\u0BBE\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BCD\u0B9F\u0BBE? \u0B89\u0B9F\u0BCD\u0B95\u0BBE\u0BB0\u0BC1\u0B99\u0BCD\u0B95. \u0B87\u0BA9\u0BCD\u0BB1\u0BC1 \u0BA4\u0BC7\u0BAF\u0BCD \u0B95\u0BC6\u0B9F\u0BCD\u0B9F\u0BBF\u0BAF\u0BBE\u0BA9\u0BA4\u0BC1."
    requiredClueId: 
    choices:
    - choiceTextEn: See you around.
      choiceTextTa: "\u0BAA\u0BBF\u0BB1\u0B95\u0BC1 \u0B9A\u0BA8\u0BCD\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BB2\u0BBE\u0BAE\u0BCD."
      nextNodeIndex: -1
      requiredClueId: 
      revealClueId: 
