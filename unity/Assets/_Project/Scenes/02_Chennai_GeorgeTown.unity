    speakerTextTa: "\u0BAE\u0BC1\u0BA4\u0BB2\u0BBF\u0BB2\u0BCD \u0BB5\u0BB2\u0BC8, \u0B87\u0BB0\u0BA3\u0BCD\u0B9F\u0BBE\u0BB5\u0BA4\u0BC1 \u0BAA\u0B9F\u0B95\u0BC1, \u0B95\u0B9F\u0BB2\u0BC1\u0B9F\u0BA9\u0BCD \u0BB5\u0BBE\u0BA4\u0BAE\u0BCD \u0B95\u0B9F\u0BC8\u0B9A\u0BBF\u0BAF\u0BBF\u0BB2\u0BCD."
    requiredClueId: 
    choices:
    - choiceTextEn: See you around.
      choiceTextTa: "\u0BAA\u0BBF\u0BB1\u0B95\u0BC1 \u0B9A\u0BA8\u0BCD\u0BA4\u0BBF\u0B95\u0BCD\u0B95\u0BB2\u0BBE\u0BAE\u0BCD."
      nextNodeIndex: -1
