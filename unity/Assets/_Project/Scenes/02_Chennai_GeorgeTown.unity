    activityDescriptionTa: "\u0B9A\u0BC2\u0B9F\u0B95\u0BB0\u0BC1\u0BA3\u0BCD\u0B9F\u0BC1 \u0B9A\u0BBE\u0BAA\u0BCD\u0BAA\u0BBF\u0B9F\u0BC1\u0BA4\u0BB2\u0BCD"
    targetPosition: {x: 6.7, y: 0.15, z: 6}
