  m_Name: 
  m_EditorClassIdentifier: WhisperingWilds::WhisperingWilds.NPC.NPCCharacter
  npcId: raman_forest_guide
  displayNameEn: Raman (Forest Guide)
  displayNameTa: "\u0BB0\u0BBE\u0BAE\u0BA9\u0BCD (\u0BB5\u0BA9 \u0BB5\u0BB4\u0BBF\u0B95\u0BBE\u0B9F\u0BCD\u0B9F\u0BBF)"
  occupation: 6
  profession: Forest Guide
  profileDescription: "\u0BA8\u0BC0\u0BB2\u0B95\u0BBF\u0BB0\u0BBF \u0B9A\u0BCB\u0BB2\u0BC8\u0B95\u0BCD\u0B95\u0BBE\u0B9F\u0BC1 \u0BAE\u0BB1\u0BCD\u0BB1\u0BC1\u0BAE\u0BCD \u0BA4\u0BCB\u0B9F\u0BB0\u0BCD \u0BAA\u0BA3\u0BCD\u0BAA\u0BBE\u0B9F\u0BCD\u0B9F\u0BC1 \u0BB5\u0BB4\u0BBF\u0B95\u0BBE\u0B9F\u0BCD\u0B9F\u0BBF \u0BB0\u0BBE\u0BAE\u0BA9\u0BCD."
  currentState: 0
  scheduledState: 0
  currentTier: 0
  targetDestination: {x: 0, y: 0, z: 0}
  stateActionTimer: 0
  structuredSchedule: []
  legacySchedule: []
  dialogueNodes:
  - nodeIndex: 0
    speakerTextEn: The forest speaks if you listen. The tahr herds move higher when the monsoon comes.
    speakerTextTa: "\u0B95\u0BBE\u0B9F\u0BCD\u0B9F\u0BC1 \u0BAA\u0BC7\u0B9A\u0BC1\u0BAE\u0BCD, \u0B95\u0BC7\u0B9F\u0BCD\u0B95\u0BBF\u0BB1\u0BC0\u0BB0\u0BBE\u0B95\u0BCD\u0BB2\u0BBE. \u0BAE\u0BB4\u0BC8 \u0BB5\u0BB0\u0BB1\u0BA4\u0BB1\u0BCD\u0B95\u0BC1 \u0BAE\u0BC1\u0BA9\u0BCD\u0BA4\u0BCD \u0BA4\u0BB5\u0BCD\u0BB1\u0BBE \u0BAE\u0BC7\u0BB2\u0BC7 \u0BAA\u0BCB\u0B95\u0BC1\u0BAE\u0BCD."
    requiredClueId: 
    choices:
    - choiceTextEn: Thank you.
      choiceTextTa: "\u0BA8\u0BA9\u0BCD\u0BB1\u0BBF."
