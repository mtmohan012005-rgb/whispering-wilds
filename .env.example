# The Whispering Wilds (Kaattu Vazhi) - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS.
# NEVER COMMIT .env TO REPOSITORY VERSION CONTROL.

# Application Environment
NODE_ENV=production
PORT=3000

# Canonical Public URL for Email Verification & Password Reset Links
APP_PUBLIC_URL=https://thewhisperingwilds.netlify.app

# SMTP Mail Delivery Provider Credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@thewhisperingwilds.com
SMTP_FROM_NAME=The Whispering Wilds
SMTP_SECURE=false

# Session & Token Secret Signing
SESSION_SECRET=
CSRF_SECRET=
