# The Whispering Wilds (Kaattu Vazhi) - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS.
# NEVER COMMIT .env TO REPOSITORY VERSION CONTROL.

# Application Environment
NODE_ENV=production
PORT=3000

# Canonical Public URL for Email Verification & Password Reset Links
APP_PUBLIC_URL=https://mtmohan012005-rgb.github.io/whispering-wilds

# SMTP Mail Delivery Provider Credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@thewhisperingwilds.com
SMTP_FROM_NAME=The Whispering Wilds
SMTP_SECURE=false

# Session & Token Secret Signing
SESSION_SECRET=
CSRF_SECRET=

# Allowed browser origin(s) for CORS. Comma-separated for multiple.
# In production this MUST list your real deployment domains, because the CSRF
# middleware trusts Origin/Referer values that appear in this list.
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# FIREBASE (canonical identity + persistence)
# ---------------------------------------------------------------------------
# The Firebase Auth UID is the canonical player identity. These values are
# required for the /api/v1/persistence/* routes and for Firebase ID token
# verification; without them those routes fail closed with HTTP 503
# FIREBASE_NOT_CONFIGURED rather than silently accepting writes.
#
# Set these as SECRET environment variables in Render. Never commit real
# values. Note: the browser SDK config (projectId/apiKey) is public by design
# and lives in js/firebase/firebase-config.js, not here.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# Service-account credentials, supplied ONE of these ways:
#   1. FIREBASE_SERVICE_ACCOUNT_JSON  - inline JSON (single-line, Render secret)
#   2. GOOGLE_APPLICATION_CREDENTIALS  - path to a mounted JSON file
#   3. nothing                        - fall back to Application Default
#                                      Credentials (automatic on GCP/Render)
# Leave all three empty to run with persistence disabled (fail-closed).
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# PostgreSQL (LEGACY / transitional only).
# The canonical store is Firestore. This is only read by the deprecated
# /api/saves routes and is scheduled for removal once Firebase is verified.
DATABASE_URL=
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# MEGA CLOUD DRIVE (alternative persistence backend)
# ---------------------------------------------------------------------------
# MEGA is an alternative to Firebase/Firestore for cloud saves. It uses the
# unofficial megajs SDK (v1.3.10). MEGA does not provide an official Node.js
# SDK — the official SDK is C++ only.
#
# RISKS: The megajs SDK is community-maintained. MEGA may change their internal
# API without notice, which could break the integration.
#
# SETUP:
# 1. Create a MEGA account at https://mega.nz
# 2. Install megajs: npm install megajs
# 3. Set MEGA_EMAIL and MEGA_PASSWORD as secret environment variables in Render
#    or in your local .env file.
# 4. The server will create a "WhisperingWildsSaves" folder in your MEGA Cloud
#    Drive and organize saves by user ID.
#
# SECURITY:
# - Never commit real MEGA credentials to the repository.
# - The MEGA account password is the encryption key for all data. If you lose
#   it, all saved data will be unrecoverable.
# - Consider using a dedicated MEGA account for game saves only.
MEGA_EMAIL=
MEGA_PASSWORD=

