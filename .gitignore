# Unity Test Framework / Performance Testing run artifacts.
# The Performance Testing package writes its machine-specific run info into
# Assets/Resources/ and it records the local editor changeset plus an empty
# Results array, so it is generated output, not project source.
unity/Assets/Resources/PerformanceTestRunInfo.json
unity/Assets/Resources/PerformanceTestRunInfo.json.meta
unity/Assets/Resources/PerformanceTestRunSettings.json
unity/Assets/Resources/PerformanceTestRunSettings.json.meta
# Unity Test Framework batch-mode runner outputs (generated)
unity/test-*.xml
unity/TestResults/

