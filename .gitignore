# Dependencies
node_modules/

# Logs & OS Files
Thumbs.db
Desktop.ini
.DS_Store
*.log
.idea/

# Test files — never commit to repo
tests/
test-*.js
test-runner.js
*-test.js
test_*.json
test_*.html
test_*.png
run_tests.*
desktop/tests/

# Exception: Unity Test Framework tests ARE source and must be versioned.
# The blanket tests/ rule above targets loose JS/Python scratch suites.
!unity/Assets/_Project/Tests/
!unity/Assets/_Project/Tests/**

# Unity build output — compiled binaries (~180 MB), never commit
Build/
unity/Build/
unity/Library/
unity/Temp/
unity/Obj/
unity/Logs/
unity/UserSettings/

# Standalone release candidate packages (compiled binaries, hundreds of MB).
# Packaged with a separate script; never commit. The *_RC/ folder variants let a
# validated candidate be parked at the repo root for manual play without polluting git.
TheWhisperingWilds_Windows_x64_RC/
TheWhisperingWilds_Windows_x64_RC_*/

# Report artifacts
ANIMATION_REPORT.json
BUILD_REPORT.json
PRODUCTION_3D_ASSET_REPORT.*
PRODUCTION_QA_REPORT.md
WORLD_STREAMING_REPORT.*
SURVIVAL_BALANCE_REPORT.md
PRODUCTION_ASSET_STATUS.json
RELEASE_CHECKLIST.md
normal_run.log
edge_stderr.log

# Temporary test outputs
screenshot.png
shot.png
test_run_shot.png
dom.html
edge_temp*

# Windows PowerShell temporary files
*.tmp

# Environment & Secrets
.env
.env.local
.env.*.local

# Unity Test Framework / Performance Testing run artifacts.
# The Performance Testing package writes its machine-specific run info into
# Assets/Resources/ and it records the local editor changeset plus an empty
# Results array, so it is generated output, not project source.
unity/Assets/Resources/PerformanceTestRunInfo.json
unity/Assets/Resources/PerformanceTestRunInfo.json.meta
unity/Assets/Resources/PerformanceTestRunSettings.json
unity/Assets/Resources/PerformanceTestRunSettings.json.meta
# Unity Test Framework batch-mode runner outputs (generated)
unity/test-*.xml

.github/workflows/
